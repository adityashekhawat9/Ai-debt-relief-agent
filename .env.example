# ====================================================
# AI Voice Platform — Environment Variables
# NEVER commit .env to version control
# ====================================================

# Application
APP_NAME=AI Voice Platform
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
PUBLIC_APP_URL="your_ngrok_or_cloudflare_tunnel_domain"

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://aicalls:changeme@postgres:5432/aicalls
POSTGRES_USER=aicalls
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aicalls

# Redis & Qdrant
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=knowledge_base

# AI Models & Keys
USE_CLOUD_LLM=true
USE_CLOUD_STT=true
USE_CLOUD_TTS=true
USE_GEMINI=false 

LLM_MODEL_PATH=/models/qwen3-4b-q4_k_m.gguf
TTS_MODEL_PATH=/models/piper/en_US-ryan-medium.onnx
PIPER_EXEC_PATH=/models/piper/piper.exe

GROQ_API_KEY=""
OPENROUTER_API_KEY=""
DEEPGRAM_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Voice & TTS
TTS_VOICE="9626c31c-bec5-4cca-baa8-f8ba9e84c8bc"
CARTESIA_API_KEY=""
ELEVENLABS_API_KEY=""

# LiveKit WebRTC
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Integrations
DATA_WEBHOOK_URL="https://your_lms.com/api/webhooks/ai-voice"
VICIDIAL_URL=http://vicidial
VICIDIAL_USER=admin
VICIDIAL_PASS=changeme
VICIDIAL_SOURCE=api
VICIDIAL_BOT_API_URL="http://103.113.27.27/bot_api/AmiHangup.php"
VICIDIAL_BOT_API_KEY="jbti89692vc60b2o9nu7647"

# Business Rules
COMPANY_NAME=YourCompanyName
ENABLE_CALL_RECORDING=false
TRANSFER_EXTENSION=90009
MAX_CALL_DURATION_SECONDS=300
MAX_CALL_ATTEMPTS_PER_LEAD=3
MAX_OBJECTION_RETRIES=2

# Authentication
JWT_SECRET_KEY=changeme-replace-with-256-bit-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_PASSWORD=admin
LOKI_URL=http://loki:3100
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="ai-voice-platform"
